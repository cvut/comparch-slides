MAKEFILE_RULES_DIR := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))
ifndef TOPDIR
TOPDIR := $(patsubst %/,%,$(dir $(MAKEFILE_RULES_DIR)))
endif

export MAKEFILE_RULES_DIR TOPDIR

ifeq ($(DOC),)
$(error DOC variable should be the base name of the LaTeX file to compile)
endif

DOC_LANG ?= cz

DOC_DATE_LOCALE := $(notdir $(filter $(DOC_LANG)/%,cz/cs_CZ.UTF-8 en/en_US.UTF-8))
ifeq ($(DOC_DATE_LOCALE),)
$(warning No date locale for DOC_LANG=$(DOC_LANG))
DOC_DATE_LOCALE := en_US.UTF-8
endif

MODDATE_FILE := moddate.tex

#SVGS = $(shell  *.svg)
ANIM = $(patsubst %,anim/%/overlay.tex,$(basename $(SVGS)))
export TEXINPUTS=.:$(TOPDIR)/_latex:$(TOPDIR):$(MAKEFILE_RULES_DIR):

XELATEX := xelatex
XELATEX_FLAGS := -recorder --shell-escape -synctex=1 -interaction=nonstopmode -file-line-error

INPUT_RAW := $(shell sed -n -e 's#^[ \t]*\\input{\([^}]*\)}.*$$#\1#pg' $(DOC).tex)
INPUT_FILES := $(wildcard $(INPUT_RAW) $(INPUT_RAW:%=$(TOPDIR)/%))

FIGS := $(shell cat $(DOC).tex $(INPUT_FILES) | sed -n -e 's#^.*{[^{}]*\(generated/[^{}]*\)}.*$$#$(TOPDIR)/\1#pg')
FIGS_SRC := $(FIGS:$(TOPDIR)/generated/%.pdf=$(TOPDIR)/common/%.svg)

.PHONY: all FORCE_MAKE

gitignore_target = grep -q '/$@' .gitignore || echo '/$@' >> .gitignore

all: $(DOC).pdf $(NUM:%=apo%_2021.pdf)

$(DOC).pdf: $(DOC).tex $(MAKEFILE_RULES_DIR)/apo-lecture-$(DOC_LANG).sty $(FIGS) $(ANIM)
	if [ -e $(DOC).toc ] ; then cp $(DOC).toc $(DOC).toc.bak ; else touch $(DOC).toc.bak ; fi
	if [ ! -e $(MODDATE_FILE) ] ; then LOCALE=$(DOC_DATE_LOCALE) LC_TIME=$(DOC_DATE_LOCALE) \
	    date --date="@0" +'%e. %B, %Y' >$(MODDATE_FILE) ; \
	fi
	$(XELATEX) $(XELATEX_FLAGS) $<
	# Retrieve all processed sources, if they are clean use their oldest common commit date,
	# if some source is modified use current date
	@DOC_DEPS="$$( sed -n -e 's#^INPUT \([^/ \t].*\|$(TOPDIR).*\)$$#\1#p' $(DOC).fls \
	    | grep -v $(MODDATE_FILE) )" && \
	if [ -n "$$(git status --porcelain -- $$DOC_DEPS $(FIGS_SRC))" ]; then \
	DATE_EPOCH="$$( date '+%s' )" ; else \
	DATE_EPOCH="$$( git log -1 --date=format:"%s" --format="%cd" -- $$DOC_DEPS $(FIGS_SRC))" ; fi && \
	LOCALE=$(DOC_DATE_LOCALE) LC_TIME=$(DOC_DATE_LOCALE) \
	    date --date="@$$DATE_EPOCH" +'%e. %B, %Y' >$(MODDATE_FILE).tmp
	# If the target slide numbers in the TOC change or modification date changes, rerun LaTeX
	( cmp $(DOC).toc $(DOC).toc.bak && cmp $(MODDATE_FILE) $(MODDATE_FILE).tmp ) || \
	( mv $(MODDATE_FILE).tmp $(MODDATE_FILE) && \
	    $(XELATEX) $(XELATEX_FLAGS) $< )
	rm -f $(DOC).toc.bak
	# Generate list of dependencies based on the report of the processed files
	sed -n -e 's/^INPUT \(.*\)$$/\1/p' $(DOC).fls | grep -v '$<' | \
	    sed -e 's/^\(.*\)$$/$@:\$$(wildcard \1)/p' >$(DOC).dep
	rm -f $(MODDATE_FILE).tmp
	$(gitignore_target)

ifneq ($(NUM),)
$(NUM:%=apo%_2021.pdf): $(DOC).pdf
	cp $< $@
	$(gitignore_target)
endif

anim/%/overlay.tex: %.svg $(MAKEFILE_RULES_DIR)/export_overlays
	$(MAKEFILE_RULES_DIR)/export_overlays $<

# Lazily evaluated variable; expensive to compute, but we only want it
# do it when first necessary.
INKSCAPE_0.X = $(eval INKSCAPE_0.X := $(shell inkscape --version|grep '^Inkscape 0'))$(INKSCAPE_0.X)

$(TOPDIR)/generated/%.pdf: $(TOPDIR)/common/%.svg
	mkdir -p $(dir $@)
	$(if $(INKSCAPE_0.X),inkscape --export-area-drawing --export-background-opacity=1.0 --export-pdf="$@" "$<",\
			     inkscape --export-area-drawing --export-background-opacity=1.0 --export-type=pdf --export-filename="-" "$<" > "$@")

-include $(DOC).dep
